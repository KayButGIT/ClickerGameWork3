  upgrades:
  - upgradeId: click
    displayName: Player Glue Value
    description: Increase the sell price of manually produced glue.
    maxLevel: 999
    baseCost: 50
    growth: 1.7
    effectStartValue: 1
    effectPerLevel: 2
    effectUnit: /per click
    effectAsPercent: 0
  - upgradeId: conveyor
    displayName: Conveyor Slot
    description: Unlock a new conveyor and double manual glue production.
    maxLevel: 2
    baseCost: 1200
    growth: 10
    effectStartValue: 1
    effectPerLevel: 1
    effectUnit: slots
    effectAsPercent: 0
  - upgradeId: boost
    displayName: Machine Product Value
    description: Boost all machine product values.
    maxLevel: 5
    baseCost: 500
    growth: 2.2
    effectStartValue: 0
    effectPerLevel: 2
    effectUnit: '%'
    effectAsPercent: 1
  - upgradeId: speed
    displayName: Machine Production Speed
    description: Increase the rate of automatic production.
    maxLevel: 4
    baseCost: 1000
    growth: 2
    effectStartValue: 5
    effectPerLevel: -1
    effectUnit: s/cycle
    effectAsPercent: 0
